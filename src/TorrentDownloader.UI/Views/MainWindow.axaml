<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TorrentDownloader.UI.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="TorrentDownloader.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Torrent Downloader"
        Width="960" Height="600">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style Selector="Button.pillAction">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="CornerRadius" Value="18" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">

        <!-- Top toolbar -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0 0 0 14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add Torrent File..." Click="OnAddTorrentFileClick" Margin="8 0 0 0" />
                <Button DockPanel.Dock="Right" Content="Add Magnet" Click="OnAddMagnetClick" Margin="8 0 0 0" />
                <TextBox PlaceholderText="Paste a magnet: link here" Text="{Binding MagnetInput}" />
            </DockPanel>

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add Link" Click="OnAddLinkClick" Margin="8 0 0 0" />
                <TextBox PlaceholderText="Paste a direct http(s):// download link here" Text="{Binding LinkInput}" />
            </DockPanel>

            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Download folder:" VerticalAlignment="Center" Margin="0 0 10 0" />
                <Button DockPanel.Dock="Right" Content="Change..." Click="OnChangeDownloadDirectoryClick" Margin="8 0 0 0" />
                <TextBox Text="{Binding DownloadDirectory}" IsReadOnly="True" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Download limit:" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding DownloadLimitKBs}" Minimum="0" Maximum="1000000" Increment="10" Width="140" FormatString="0" />
                    <TextBlock Text="KB/s (0 = unlimited)" VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Upload limit:" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding UploadLimitKBs}" Minimum="0" Maximum="1000000" Increment="10" Width="140" FormatString="0" />
                    <TextBlock Text="KB/s (0 = unlimited)" VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
                </StackPanel>
            </StackPanel>

            <Border Background="#D64545" Padding="14,10" CornerRadius="18" IsVisible="{Binding IsOffline}">
                <TextBlock Text="No network connection — active downloads are paused and will resume automatically once you're back online." Foreground="White" TextWrapping="Wrap" />
            </Border>

            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="14" Padding="10,6">
                <TextBlock Text="{Binding DiagnosticsText}" Opacity="0.65" FontSize="11" />
            </Border>

            <Border Background="#D64545" CornerRadius="14" Padding="10,6" IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12" />
            </Border>
        </StackPanel>

        <!-- Torrents + direct downloads -->
        <ScrollViewer>
            <StackPanel Spacing="10">
                <TextBlock Text="Torrents" FontWeight="Bold" Margin="4 0 0 0" IsVisible="{Binding Torrents.Count}" />
                <ItemsControl ItemsSource="{Binding Torrents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TorrentItemViewModel">
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="20" Padding="16,14" Margin="0 0 0 10"
                                    BoxShadow="0 1 6 0 #22000000">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="pillAction" Content="Resume" IsVisible="{Binding IsPaused}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).StartCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="pillAction" Content="Pause" IsVisible="{Binding !IsPaused}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PauseCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="pillAction" Content="Remove"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="10" Padding="9,3" Opacity="0.85">
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="White" />
                                        </Border>
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10" Padding="9,3">
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" />
                                        </Border>
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10" Padding="9,3">
                                            <TextBlock Text="{Binding DownloadRateText, StringFormat='↓ {0}'}" FontSize="11" />
                                        </Border>
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10" Padding="9,3">
                                            <TextBlock Text="{Binding UploadRateText, StringFormat='↑ {0}'}" FontSize="11" />
                                        </Border>
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10" Padding="9,3">
                                            <TextBlock Text="{Binding PeersText}" FontSize="11" />
                                        </Border>
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10" Padding="9,3">
                                            <TextBlock Text="{Binding EtaText, StringFormat='ETA: {0}'}" FontSize="11" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding TrackerStatusText, StringFormat='Tracker: {0}'}" Opacity="0.55" FontSize="11" />

                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6" Height="8" ClipToBounds="True">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="8" Background="Transparent" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Direct downloads" FontWeight="Bold" Margin="4 16 0 0" IsVisible="{Binding Downloads.Count}" />
                <ItemsControl ItemsSource="{Binding Downloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HttpDownloadItemViewModel">
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="20" Padding="16,14" Margin="0 0 0 10"
                                    BoxShadow="0 1 6 0 #22000000">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="pillAction" Content="Resume" IsVisible="{Binding IsPaused}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ResumeDownloadCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="pillAction" Content="Pause" IsVisible="{Binding !IsPaused}" IsEnabled="{Binding !IsCompleted}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PauseDownloadCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="pillAction" Content="Remove"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveDownloadCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPaused}">
                                        <TextBox Text="{Binding NewUrlInput}" PlaceholderText="Paste a new link to resume an expired download…" Width="320" FontSize="11" />
                                        <Button Classes="pillAction" Content="Update Link &amp; Resume"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UpdateLinkAndResumeCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="10" Padding="9,3" Opacity="0.85">
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="White" />
                                        </Border>
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10" Padding="9,3">
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" />
                                        </Border>
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10" Padding="9,3" IsVisible="{Binding DownloadRateText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding DownloadRateText, StringFormat='↓ {0}'}" FontSize="11" />
                                        </Border>
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10" Padding="9,3" IsVisible="{Binding EtaText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding EtaText, StringFormat='ETA: {0}'}" FontSize="11" />
                                        </Border>
                                    </StackPanel>

                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6" Height="8" ClipToBounds="True">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="8" Background="Transparent" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
